{
  "version": "1.0",
  "note": "Lexicon used by humanize.py and detect.py. Replacements are plain-English and keep the sentence grammatical. The last block of each list is Instagram-specific: caption and voiceover slop that does not show up on other platforms. Edit freely - it is meant to be yours. An invisible entry with action 'stray' is deleted only where it is not doing the job its 'keep' field names. The fa- families at the end of each list are Persian: written by hand for Persian Instagram, not measured against a corpus. A space in a Persian entry also matches a half-space.",
  "invisible": [
    {
      "cp": "U+200B",
      "name": "ZERO WIDTH SPACE",
      "action": "delete"
    },
    {
      "cp": "U+200C",
      "name": "ZERO WIDTH NON-JOINER",
      "action": "stray",
      "keep": "between two Persian letters, where it is the half-space (نیم‌فاصله) and part of the spelling"
    },
    {
      "cp": "U+200D",
      "name": "ZERO WIDTH JOINER",
      "action": "stray",
      "keep": "between two emoji, where it builds one emoji out of two"
    },
    {
      "cp": "U+2060",
      "name": "WORD JOINER",
      "action": "delete"
    },
    {
      "cp": "U+FEFF",
      "name": "ZERO WIDTH NO-BREAK SPACE / BOM",
      "action": "delete"
    },
    {
      "cp": "U+00AD",
      "name": "SOFT HYPHEN",
      "action": "delete"
    },
    {
      "cp": "U+180E",
      "name": "MONGOLIAN VOWEL SEPARATOR",
      "action": "delete"
    },
    {
      "cp": "U+061C",
      "name": "ARABIC LETTER MARK",
      "action": "stray",
      "keep": "in Persian text, where it sets the direction of mixed Persian and English"
    },
    {
      "cp": "U+200E",
      "name": "LEFT-TO-RIGHT MARK",
      "action": "stray",
      "keep": "in Persian text, where it sets the direction of mixed Persian and English"
    },
    {
      "cp": "U+200F",
      "name": "RIGHT-TO-LEFT MARK",
      "action": "stray",
      "keep": "in Persian text, where it sets the direction of mixed Persian and English"
    },
    {
      "cp": "U+E0000-U+E007F",
