  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "\"It's not just X, it's Y\"",
      "fix": "Say the one thing you actually mean. Delete the setup half."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "\"Not only X but also Y\"",
      "fix": "Split into two sentences, or drop the weaker half."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "\"It isn't about X. It's about Y.\"",
      "fix": "Lead with Y. The reversal is the tell."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "One-word rhetorical question line",
      "fix": "Answer it inline instead of staging a reveal."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "\"Here's what I learned\"",
      "fix": "State the lesson. Skip the announcement."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Rule-of-three triad",
      "fix": "Two items or four. Three is the model's default rhythm."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#[\\w\\u200c]+\\s*){6,}",
      "name": "Hashtag wall (6+)",
      "fix": "Three to five topic tags. Instagram counts five at most per post, and the rest read as an old habit."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "Model self-reference",
      "fix": "Delete the sentence."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Essay-closer opener",
      "fix": "A post does not need a conclusion paragraph."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Reflex engagement bait",
      "fix": "Ask a question only you could ask, about the specific thing above it."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:stop scrolling|don'?t scroll|wait[,.]? don'?t scroll)\\b",
      "name": "\"Stop scrolling\" opener",
      "fix": "The scroll-stop has to be the claim itself. Asking for attention is the tell that you have not earned it."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:in (?:this|today'?s) (?:video|reel|post)|today i'?m going to show you|i'?m going to (?:show|teach) you how)\\b",
      "name": "Video preamble (\"in this video I'm going to show you\")",
      "fix": "Delete it and start at the payoff. The first two seconds decide the whole reel."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Emoji bullet list",
      "fix": "Use a hyphen or a line break. Emoji bullets are the single most template-looking thing in a caption."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-Z]{3,}\\b(?:\\s+\\b[A-Z]{3,}\\b){2,}",
      "name": "Three or more shouted words in a row",
      "fix": "Caps are a volume knob, not a highlighter. One word, at most."
    },
    {
      "id": "follow-bait",
      "regex": "(?i)\\b(?:follow for more|tag someone who|double tap if|share this if|comment below if)\\b",
      "name": "Reflex follow or tag bait",
      "fix": "Ask for the one action this post actually earns. The generic ask trains the audience to ignore every ask."
    },
    {
      "id": "fa-not-only",
      "regex": "نه[\\s\\u200c]+تنها[^.!?؟\\n]{2,80}بلکه",
      "name": "«نه تنها X، بلکه Y»",
      "fix": "یکی را بگو. این قالب دوتکه اولین چیزی است که مدل‌ها می‌نویسند."
    },
    {
      "id": "fa-not-just",
      "regex": "(?:این|اون|آن)[\\s\\u200c]+فقط[\\s\\u200c]+[^.!?؟\\n]{2,60}?[\\s\\u200c]+نیست[،,.]",
      "name": "«این فقط X نیست، Y است»",
      "fix": "مستقیم بگو Y چیست. مقدمه‌ی «فقط این نیست» چیزی اضافه نمی‌کند."
    },
    {
      "id": "fa-isnt-about",
      "regex": "(?:بحث|موضوع|مسئله|ماجرا)[\\s\\u200c]+[^.!?؟\\n]{2,60}?[\\s\\u200c]+نیست[،,.][\\s\\u200c]*(?:بحث|موضوع|مسئله|ماجرا)",
      "name": "«موضوع X نیست، موضوع Y است»",
      "fix": "فقط Y را بگو."
    },
    {
      "id": "fa-the-result",
      "regex": "(?m)^[\\s\\u200c]*(?:نتیجه|نتیجه‌اش|نتیجش|نکته|اما[\\s\\u200c]+نکته|ولی[\\s\\u200c]+نکته|بهترین[\\s\\u200c]+(?:بخش|قسمت)ش?)[\\s\\u200c]*(?:چی[\\s\\u200c]+بود|چه[\\s\\u200c]+بود|چیه|چیست)?[\\s\\u200c]*[؟?][\\s\\u200c]*$",
      "name": "سؤال یک‌کلمه‌ای نمایشی («نتیجه؟»)",
      "fix": "خود نتیجه را بگو. این مکث نمایشی امضای متن ماشینی است."
    },
    {
      "id": "fa-triad",
      "regex": "(?:^|[\\s\\u200c])[\\w\\u200c]+،[\\s\\u200c]*[\\w\\u200c]+[\\s\\u200c]+و[\\s\\u200c]+[\\w\\u200c]+\\.",
      "name": "سه‌تایی «X، Y و Z.»",
      "fix": "دو مورد یا چهار مورد. سه‌تایی ریتم پیش‌فرض مدل است."
    },
    {
      "id": "fa-in-this-video",
      "regex": "(?:در|توی|تو)[\\s\\u200c]+(?:این[\\s\\u200c]+(?:ویدیو|ویدئو|ریلز)|ویدیوی[\\s\\u200c]+امروز)|(?:قراره|می[\\s\\u200c]*خوام|می[\\s\\u200c]*خواهم)[\\s\\u200c]+(?:بهتون|به[\\s\\u200c]+شما)[\\s\\u200c]+(?:نشون|نشان|بگم|بگویم)",
      "name": "مقدمه‌ی ویدیو («در این ویدیو قراره نشونتون بدم»)",
      "fix": "مقدمه را حذف کن و با خود نتیجه شروع کن."
    },
    {
      "id": "fa-stop-scroll",
      "regex": "(?m)^[\\s\\u200c]*(?:اسکرول[\\s\\u200c]+نکن(?:ید)?|رد[\\s\\u200c]+نشو(?:ید)?)",
      "name": "شروع با «اسکرول نکن»",
      "fix": "توجه را با حرف اول به دست بیاور، نه با خواهش."
    },
    {
      "id": "fa-follow-bait",
      "regex": "برای[\\s\\u200c]+(?:دیدن[\\s\\u200c]+)?\\S+[\\s\\u200c]+بیشتر[\\s\\u200c]+(?:ما[\\s\\u200c]+را[\\s\\u200c]+)?فالو|\\bتگ[\\s\\u200c]+کن(?:ید)?\\b|اگه[\\s\\u200c]+موافقی[\\s\\u200c]+لایک",
      "name": "درخواست فالو یا تگ از روی عادت",
      "fix": "فقط یک درخواست بکن، همانی که این پست واقعاً به دست آورده."
    },
    {
      "id": "fa-in-summary",
      "regex": "(?m)^[\\s\\u200c]*(?:در[\\s\\u200c]+نتیجه|در[\\s\\u200c]+پایان|به[\\s\\u200c]+طور[\\s\\u200c]+خلاصه|خلاصه[\\s\\u200c]+اینکه|در[\\s\\u200c]+مجموع)",
      "name": "جمع‌بندی انشایی («در پایان»، «به طور خلاصه»)",
      "fix": "کپشن انشا نیست. جمله‌ی آخر را حذف کن یا با یک عدد تمامش کن."
    },
    {
      "id": "fa-as-an-ai",
      "regex": "به[\\s\\u200c]*عنوان[\\s\\u200c]+یک[\\s\\u200c]+(?:هوش[\\s\\u200c]+مصنوعی|مدل[\\s\\u200c]+زبانی)",
      "name": "مدل از خودش حرف می‌زند",
      "fix": "این خط را کامل حذف کن."
    },
    {
      "id": "fa-engagement-bait",
      "regex": "(?m)(?:موافقی|موافقید|کی[\\s\\u200c]+دیگه|اشتباه[\\s\\u200c]+می[\\s\\u200c]*کنم)[\\s\\u200c]*[؟?][\\s\\u200c]*$",
      "name": "سؤال تعاملی کلیشه‌ای («موافقی؟»)",
      "fix": "سؤالی بپرس که فقط خودت می‌توانی بپرسی، درباره‌ی همین موضوع."
    }
  ]
}
